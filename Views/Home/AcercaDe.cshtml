@{
    ViewData["Title"] = "Acerca de";
}

<section class="content-header py-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h2 class="fw-bold ls-1">
                    <i class="fa-solid fa-circle-info text-peach me-2"></i> Acerca de
                </h2>
                <h5 class="text-muted mb-0 ls-1">Conoce la historia detrás del lienzo digital.</h5>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb justify-content-sm-end bg-transparent p-0 m-0 align-items-center">
                        <li class="breadcrumb-item fs-4">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted hover-peach">Inicio</a>
                        </li>
                        <li class="breadcrumb-item active fs-4 text-peach" aria-current="page">
                            Nosotros
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>

<section class="content pb-5">
    <div class="container">

        <div class="card card-custom border-0 shadow-lg">
            <div class="card-body p-0">
                <div class="row g-0">

                    <div class="col-lg-7 p-5">
                        <h3 class="mb-4 text-white ls-1">Nuestra Misión</h3>

                        <p class="text-muted lead mb-4 fs-4" style="text-align: justify;">
                            <span class="text-peach fw-bold">Aurora's Gallery</span> nació de una necesidad simple pero profunda: crear un refugio seguro para el arte humano en la era digital.
                        </p>

                        <p class="text-muted mb-4 fs-5" style="text-align: justify;">
                            En un mundo saturado de contenido generado automáticamente, buscamos devolver el protagonismo al trazo, a la imperfección hermosa y al alma que solo un artista real puede imprimir en su obra. Esta plataforma no es solo una galería; es un ecosistema diseñado para conectar a creadores con coleccionistas que valoran la autenticidad.
                        </p>

                        <div class="row mt-5 g-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-start">
                                    <i class="fa-solid fa-check text-peach fs-4 me-3 mt-1"></i>
                                    <div>
                                        <h5 class="text-white mb-1">Tecnología .NET</h5>
                                        <p class="text-muted">Potenciado por ASP.NET Core 8 para máxima velocidad y seguridad.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-start">
                                    <i class="fa-solid fa-check text-peach fs-4 me-3 mt-1"></i>
                                    <div>
                                        <h5 class="text-white mb-1">Diseño Responsivo</h5>
                                        <p class="text-muted">Una experiencia fluida desde móviles hasta pantallas 4K.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-5 bg-dark-accent p-5 d-flex flex-column align-items-center text-center text-white">

                        <div class="mb-4 position-relative">
                            <img src="~/imagenes/gg1.png"
                                 alt="Desarrollador"
                                 class="rounded-circle shadow-lg border border-2 border-light"
                                 width="150" height="150">

                            <span class="position-absolute bottom-0 end-0 bg-success border border-dark rounded-circle p-2" title="Disponible">
                                <span class="visually-hidden">Online</span>
                            </span>
                        </div>

                        <h3 class="text-peach ls-1 mb-1">AleTkt</h3>
                        <p class="text-white-50 mb-4 fs-5">Full Stack Developer y Desarrollador de la página</p>

                        <p class="text-muted mb-4 px-3 fs-5">
                            "Desarrollador y artista apasionado que busca crear entornos de desarrollo web donde se combine en armonía el funcionamiento robusto de los programas junto con el diseño estético."
                        </p>

                        <div class="mt-auto d-flex gap-3">
                            <a href="https://github.com/AleTkt" target="_blank" class="btn btn-outline-custom btn-sm">
                                <i class="fa-brands fa-github me-2"></i> GitHub
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>