@{
    ViewData["Title"] = "Inicio";
}

<div class="container">

<div class="hero-banner p-5 mb-5 rounded-4 d-flex align-items-center justify-content-center fade-in-up">
    <div class="hero-content text-center fade-in-up">

        <h1 class="display-3 fw-bold mb-3">
            Bienvenido a <span class="gradient-text">Aurora's Gallery</span>
        </h1>

        <p class="lead text-light mb-4 mx-auto" style="max-width: 700px;">
            El refugio digital para artistas que buscan autenticidad.
            Explora, colecciona y conecta en un entorno diseñado para el arte humano.
        </p>
    </div>
</div>

<div class="row g-4 py-4 row-cols-1 row-cols-lg-3">

    <div class="col">
        <div class="feature-card h-100 p-4 rounded-4 border-0 fade-in-up">
            <div class="icon-box mb-3 text-peach">
                <i class="fa-solid fa-paintbrush fa-3x"></i>
            </div>
            <h3 class="fs-2 text-white">Arte Auténtico</h3>
            <p class="text-muted fs-5">
                Un espacio dedicado exclusivamente al talento humano.
                Promovemos la creatividad original y las técnicas tradicionales en medios digitales. 
            </p>
        </div>
    </div>

    <div class="col">
        <div class="feature-card h-100 p-4 rounded-4 border-0 fade-in-up">
            <div class="icon-box mb-3 text-purple">
                <i class="fa-solid fa-shield-halved fa-3x"></i>
            </div>
            <h3 class="fs-2 text-white">Protección Total</h3>
            <p class="text-muted fs-5">
                Tu propiedad intelectual es nuestra prioridad.
                Políticas estrictas contra el plagio y marcas de agua dinámicas para proteger tus obras.
            </p>
        </div>
    </div>

    <div class="col">
        <div class="feature-card h-100 p-4 rounded-4 border-0 fade-in-up">
            <div class="icon-box mb-3 text-peach">
                <i class="fa-solid fa-users fa-3x"></i>
            </div>
            <h3 class="fs-2 text-white">Comunidad</h3>
            <p class="text-muted fs-5">
                Conecta directamente con tus artistas favoritos
                y apoya el talento emergente.
            </p>
        </div>
    </div>

</div>

</div>