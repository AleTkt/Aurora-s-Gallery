@{
    Layout = null;
    ViewData["Title"] = "Recuperar Contraseña";
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aurora's Gallery</title>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/fontawesome/css/all.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/toast-style.css" asp-append-version="true">
</head>
<body class="auth-bg auth-body-fix">

    <nav class="navbar fixed-top px-4 py-3">
        <div class="container-fluid">
            <a href="/" class="d-flex align-items-center text-decoration-none">
                <img src="~/imagenes/Logo Aurora F.png" alt="Logo" width="80" height="80" class="me-2">
                <span class="logo-text">Aurora's Gallery</span>
            </a>
        </div>
    </nav>

    <div class="min-vh-100 d-flex align-items-center justify-content-center container">
        <div class="col-md-5 col-lg-4">

            <div class="card card-custom border-0 shadow-lg p-4">
                <div class="card-body">

                    <div class="text-center mb-4">
                        <h1 class="fw-bold text-white ls-1">Recuperar Acceso</h1>
                        <p class="text-muted small fs-4">Ingresa tu correo electrónico y te enviaremos las instrucciones para restablecer tu contraseña.</p>
                    </div>

                    <form id="frmRecuperar">
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="correo" class="form-label text-muted small ms-1 fs-5">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-peach fs-5">
                                    <i class="fa-solid fa-envelope"></i>
                                </span>
                                <input type="email" class="form-control form-control-custom border-start-0 ps-0 fs-5" id="r_correo" name="correo" placeholder="ejemplo@correo.com" required>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-custom w-100 py-2 fs-3 mb-4 shadow-purple">
                            Enviar Enlace
                        </button>

                        <div class="text-center mt-3">
                            <a asp-controller="Usuario" asp-action="Login" class="text-peach fw-bold text-decoration-none hover-white fs-5">
                                <i class="fa-solid fa-arrow-left ms-1 fs-5"></i> Volver a Iniciar Sesión
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/ajax-scripts.js" asp-append-version="true"></script>
    <script src="~/js/toast-script.js"></script>
</body>
</html>